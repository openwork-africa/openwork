{
  "workspace": [
    "./packages/kit",
    "./packages/ui",
    "./packages/store",
    "./packages/shell",
    "./packages/conversation",
    "./plugins/text",
    "./plugins/circle",
    "./plugins/rooms",
    "./plugins/panel",
    "./plugins/profile",
    "./plugins/members",
    "./app",
    "./docs/examples"
  ],
  "tasks": {
    "fmt": "deno fmt",
    "test": "deno test -A --ignore=tools",
    "lint": "deno lint packages plugins tools app docs/examples",
    "check": "deno check packages plugins tools docs/examples app/main.tsx app/product.ts app/pwa/stamp-sw.ts",
    "fitness": "deno test -A tools/fitness.test.ts",
    "build": "deno task --cwd app build && test -f app/dist/index.html",
    "test:bundle": "deno test -A tools/bundle.test.ts",
    "test:e2e": "deno test -A tools/e2e.test.ts",
    "test:base-only": "deno test -A app/baseOnly.test.tsx",
    "test:remove-each": "deno test -A app/removeEach.test.tsx --"
  },
  "fmt": { "lineWidth": 160 },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ]
  },
  "nodeModulesDir": "auto",
  "exclude": [
    "app/dist",
    "app/.vite",
    "**/node_modules"
  ],
  "imports": {
    "react": "npm:react@^19.3",
    "react/jsx-runtime": "npm:react@^19.3/jsx-runtime",
    "react-dom/server": "npm:react-dom@^19.3/server",
    "@types/react": "npm:@types/react@^19.3",
    "@std/assert": "jsr:@std/assert@^1",
    "happy-dom": "npm:happy-dom@^20",
    "react-dom/client": "npm:react-dom@^19.3/client",
    "@astryxdesign/core": "npm:@astryxdesign/core@^0.6.5",
    "@astryxdesign/core/": "npm:/@astryxdesign/core@^0.6.5/",
    "@stylexjs/stylex": "npm:@stylexjs/stylex@^0.19.0",
    "lucide-react": "npm:lucide-react@^1.18",
    "fake-indexeddb": "npm:fake-indexeddb@^6",
    "react-dom": "npm:react-dom@^19.3",
    "@types/react-dom": "npm:@types/react-dom@^19"
  }
}
